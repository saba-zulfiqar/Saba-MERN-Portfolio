# ============================================================
# SABA ZULFIQAR PORTFOLIO — BACKEND ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to a new file named ".env" in the SAME folder
# (backend/.env) and fill in your real values.
#
#   Windows (PowerShell):
#     Copy-Item .env.example .env
#
#   macOS / Linux:
#     cp .env.example .env
#
# IMPORTANT: never commit the .env file to GitHub — it holds
# secrets. It is already listed in the project's .gitignore.

# ------------------------------------------------------------
# Server port (leave at 5000 if you are not sure)
# ------------------------------------------------------------
PORT=5000

# ------------------------------------------------------------
# MongoDB Atlas connection string
# ------------------------------------------------------------
# 1. Go to https://cloud.mongodb.com -> create a free M0 cluster.
# 2. Click "Connect" -> "Drivers".
# 3. Copy the connection string, e.g.:
#      mongodb+srv://saba:<password>@cluster0.xxxxx.mongodb.net/
# 4. Replace <password> with the database user password you
#    created (Database Access tab), and add the database name
#    at the end, e.g.:
#      mongodb+srv://saba:myPassword123@cluster0.xxxxx.mongodb.net/portfolio
# 5. Also allow your IP in "Network Access" -> "Add IP address"
#    (or allow access from anywhere with 0.0.0.0/0 for a demo).
# ------------------------------------------------------------
MONGO_URI=

# ------------------------------------------------------------
# JWT secret — use a long, random string
# ------------------------------------------------------------
# Generate one with a terminal command:
#   Windows (PowerShell):  -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 60 | % {[char]$_})
#   macOS / Linux:         openssl rand -base64 48
# ------------------------------------------------------------
JWT_SECRET=

# ------------------------------------------------------------
# Admin login credentials (used only on the very first startup
# to create the admin account; change the password after that)
# ------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# ------------------------------------------------------------
# Contact form email (Nodemailer → Gmail SMTP)
# ------------------------------------------------------------
# EMAIL_USER: the Gmail address emails are SENT FROM
#             (usually sabazulfiqar926@gmail.com)
#
# EMAIL_PASS: a Gmail "APP PASSWORD" — NOT your normal Gmail
#             password! Generate one at:
#               1. https://myaccount.google.com/security   (sign in)
#               2. Turn ON "2-Step Verification" (required)
#               3. Go to https://myaccount.google.com/apppasswords
#               4. Create a new app password (name it "Portfolio")
#               5. Copy the 16-character code — spaces are fine
#               6. Paste it here between the quotes
#
# EMAIL_TO: where contact-form messages are delivered.
#           Defaults to EMAIL_USER if left blank.
# ------------------------------------------------------------
EMAIL_USER=sabazulfiqar926@gmail.com
EMAIL_PASS=your_16_character_app_password
EMAIL_TO=

# ------------------------------------------------------------
# VERCEL
# ------------------------------------------------------------
# Vercel sets VERCEL=1 automatically on every deployment — you
# do NOT need to set this yourself. It is used by the code to
# detect serverless mode (read-only filesystem, connection
# caching). For local development it stays unset/unused.
VERCEL=